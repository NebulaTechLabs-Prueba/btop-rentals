# Caddy — reverse proxy con HTTPS automático (Let's Encrypt).
# Instalar en el server como /etc/caddy/Caddyfile y recargar: sudo systemctl reload caddy
#
# Requisito: los registros DNS A/AAAA de btop-rentals.com y www ya deben apuntar
# a la IP del server (Caddy valida el dominio para emitir el certificado).

# Snippet: reenvía a la API de Supabase ocultando el proveedor.
# Elimina cabeceras de respuesta que revelarían el backend (Supabase/Deno) — visibles
# p.ej. en la pestaña de red del navegador o en los logs de webhook de Stripe.
(sbproxy) {
	reverse_proxy https://onpvhedeinpsggdanylg.supabase.co {
		header_up Host onpvhedeinpsggdanylg.supabase.co
		header_down -X-Served-By
		header_down -X-Deno-Execution-Id
		header_down -X-Deno-Ray
		header_down -Set-Cookie
		header_down -Server
		header_down -Via
		header_down -Sb-Gateway-Version
		header_down -X-Sb-Edge-Region
	}
}

# www → apex (301)
www.btop-rentals.com {
	redir https://btop-rentals.com{uri} permanent
}

btop-rentals.com {
	encode gzip zstd

	# Webhook de pagos: alias propio -> función específica (raw body intacto para la firma).
	handle /api/stripe/webhook {
		rewrite * /functions/v1/stripe-webhook
		import sbproxy
	}

	# Enmascarado del backend: toda la API de Supabase (rest/auth/storage/functions/realtime)
	# bajo el dominio propio. `handle_path` quita el prefijo /api antes de reenviar.
	# El cliente supabase-js apunta a `${origin}/api` cuando VITE_SUPABASE_PROXY=true.
	handle_path /api/* {
		import sbproxy
	}

	# App
	handle {
		reverse_proxy localhost:3000
	}

	# Cabeceras de seguridad básicas
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}
